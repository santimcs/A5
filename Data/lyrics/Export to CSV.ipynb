    "import csv\n",
    "\n",
    "with open('top 50 cry songs.csv', 'r', newline='') as infile, \\\n",
    "     open('outputfile.csv', 'w', newline='') as outfile:\n",
    "    reader = csv.reader(infile, delimiter='|')\n",
    "    writer = csv.writer(outfile)\n",
    "    for row in reader:\n",
    "        writer.writerow(row)\n"
